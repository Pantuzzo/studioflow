# Base URL of the REST API. Kept relative so the app and the API share an
# origin: Vite proxies /api to the NestJS server in development, and a reverse
# proxy does the same in production. Same-origin is what makes the SameSite
# session cookie behave identically in both. See docs/adr/0006.
VITE_API_URL=/api

# Where the Vite dev server proxies /api. Only used by `pnpm dev`.
VITE_API_PROXY_TARGET=http://localhost:3000

# Run against Mock Service Worker instead of the real API.
#   true  — no backend needed; the app and Storybook work without Docker.
#   false — talk to the NestJS API through the proxy above.
# Deliberately independent of DEV, so a production build can also be demoed
# on mocks and `pnpm dev` can be pointed at the real API.
VITE_ENABLE_MOCKS=true

# Stripe publishable key (test mode) — used from Week 8 onward.
VITE_STRIPE_PUBLISHABLE_KEY=
