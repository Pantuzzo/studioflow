# Base URL of the REST API. During Week 1-2 the app runs fully on MSW mocks,
# so this can stay pointed at the same origin (/api).
VITE_API_URL=/api

# Enable Mock Service Worker in the browser (true until the real backend exists).
VITE_ENABLE_MOCKS=true

# Stripe publishable key (test mode) — used from Week 8 onward.
VITE_STRIPE_PUBLISHABLE_KEY=
