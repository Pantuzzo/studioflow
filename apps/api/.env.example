# Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://studioflow:studioflow@localhost:5432/studioflow?schema=public"

# Origin allowed to send credentialed requests (the web client).
WEB_ORIGIN="http://localhost:5173"

# Session lifetimes, in seconds.
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=604800

NODE_ENV=development
PORT=3000

# Stripe, test mode. Optional: without them the payment endpoints refuse
# politely and the rest of the app runs unchanged.
# STRIPE_SECRET_KEY="sk_test_..."
# Printed by `stripe listen --forward-to localhost:3000/api/stripe/webhook`.
# STRIPE_WEBHOOK_SECRET="whsec_..."
