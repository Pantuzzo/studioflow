// StudioFlow data model.
//
// Prisma 7 notes:
// - The connection URL lives in prisma.config.ts (for the CLI), not here.
// - At runtime the client requires a driver adapter; PrismaService passes
//   @prisma/adapter-pg. Instantiating PrismaClient bare throws.
// - The "prisma-client-js" generator is kept on purpose: it emits CommonJS into
//   node_modules, whereas the newer "prisma-client" generator emits TypeScript
//   with .ts import specifiers, which Nest's tsc build cannot emit from.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  /// argon2id hash. The plaintext password never leaves the request handler.
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Invoice numbers are drawn from here, never from a count of existing rows.
  /// Incrementing is atomic, so two concurrent generations cannot collide, and
  /// deleting an invoice does not release its number back into the sequence.
  invoiceSeq Int @default(0)

  sessions  Session[]
  clients     Client[]
  projects    Project[]
  proposals   Proposal[]
  timeEntries TimeEntry[]
  invoices    Invoice[]

  @@map("users")
}

/// A browser session. The cookie carries an opaque random id; this table stores
/// only its SHA-256, so a database leak cannot be replayed as a live session.
model Session {
  id String @id @default(uuid())

  /// SHA-256 of the opaque session token. Never the token itself.
  tokenHash String @unique

  /// Rotation lineage. Presenting an already-revoked token means the cookie
  /// leaked, so the whole family is revoked rather than just that one session.
  familyId String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  /// Absolute timeout — a session dies at this point no matter how active it is.
  expiresAt  DateTime
  revokedAt  DateTime?

  /// Why the session ended: "rotated" | "logout" | "reuse".
  /// Only "rotated" earns the brief grace window for requests that raced the
  /// rotation. A logout must be effective immediately, and a reuse revocation
  /// must never be forgiven.
  revokedReason String?

  userAgent String?
  ip        String?

  @@index([userId])
  @@index([familyId])
  @@map("sessions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  company   String
  email     String
  /// ISO 4217 code, e.g. "USD".
  currency  String   @db.Char(3)
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  projects  Project[]
  proposals Proposal[]
  invoices  Invoice[]

  @@index([ownerId])
  @@map("clients")
}

/// Lowercase members on purpose: they cross the wire exactly as written, so the
/// contract needs no translation layer between the database and the client.
enum ProjectStatus {
  active
  paused
  completed

  @@map("project_status")
}

/// A piece of work done for a client. Deleting the client takes its projects
/// with it — a project without a client is not a thing the product has.
model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(active)

  /// What an hour on this project costs, in minor units of the client's
  /// currency. On the project rather than the client: two projects for one
  /// client are routinely billed differently.
  hourlyRateCents Int @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Denormalised owner. It duplicates client.ownerId, and it earns that:
  /// every query is scoped by owner, and joining through clients to prove
  /// ownership on each one is a footgun waiting for the query someone forgets.
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  proposals   Proposal[]
  timeEntries TimeEntry[]

  @@index([ownerId])
  @@index([clientId])
  @@map("projects")
}

enum ProposalStatus {
  draft
  sent
  accepted
  declined

  @@map("proposal_status")
}

/// A proposal document.
///
/// `blocks` is jsonb rather than a table of rows: the document is read and
/// written whole, and its blocks have no identity worth querying on their own.
/// The shape is not freeform — every write is validated against the Zod union
/// in packages/contracts before it reaches this column. See ADR 0007.
model Proposal {
  id        String         @id @default(cuid())
  title     String
  status    ProposalStatus @default(draft)
  blocks    Json           @default("[]")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Optional: not every proposal concerns a project that already exists.
  /// Deleting the project keeps the proposal and forgets the link, because the
  /// document is the thing of value here.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([clientId])
  @@index([projectId])
  @@map("proposals")
}

/// A stretch of time worked on a project.
///
/// There is no duration column. Duration is `endedAt - startedAt`, and a row
/// with no `endedAt` is a timer that is still running. Three fields that can
/// disagree would eventually disagree, and an invoice would read the wrong one.
///
/// "At most one running entry per account" is enforced in the service rather
/// than here: Postgres can express it as a partial unique index, but Prisma
/// cannot describe one, so it would be invisible to the schema and dropped by
/// the next migration that did not know about it.
model TimeEntry {
  id          String    @id @default(cuid())
  description String    @default("")
  startedAt   DateTime
  endedAt     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// Set when the entry is billed. Its presence is what stops the same hour
  /// being invoiced twice; deleting the invoice releases the entries rather
  /// than destroying them.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([projectId])
  @@index([invoiceId])
  @@map("time_entries")
}

enum InvoiceStatus {
  draft
  sent
  paid
  void

  @@map("invoice_status")
}

/// An invoice, which is a snapshot rather than a view.
///
/// The client's name, company and currency are copied in at generation, and
/// the lines are frozen jsonb. Renaming a client or moving them to another
/// currency next month must not rewrite what was billed last month.
model Invoice {
  id     String        @id @default(cuid())
  /// Sequential per account and never reused. Uniqueness is enforced by the
  /// database, so two concurrent generations cannot claim the same number.
  number Int
  status InvoiceStatus @default(draft)

  clientId      String
  client        Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientName    String
  clientCompany String
  currency      String @db.Char(3)

  lines Json @default("[]")

  issuedAt  DateTime @default(now())
  dueAt     DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  timeEntries TimeEntry[]

  @@unique([ownerId, number])
  @@index([ownerId])
  @@index([clientId])
  @@map("invoices")
}
