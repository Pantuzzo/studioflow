{
  "name": "studioflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mini-SaaS de operações para agências e freelancers — propostas, contratos, time tracking, faturas e pagamentos.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.1",
  "scripts": {
    "dev": "pnpm -F @studioflow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm -F @studioflow/web storybook",
    "build-storybook": "pnpm -F @studioflow/web build-storybook"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msw",
      "prisma",
      "unrs-resolver"
    ]
  }
}
