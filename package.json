{
  "name": "studioflow",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mini-SaaS de operações para agências e freelancers — propostas, contratos, time tracking, faturas e pagamentos.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -F @studioflow/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "pnpm -F @studioflow/web storybook",
    "build-storybook": "pnpm -F @studioflow/web build-storybook",
    "postinstall": "pnpm -F @studioflow/web msw:init"
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
